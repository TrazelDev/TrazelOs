SOURCE_FILES != find *.c
OBJ_FILES := $(addprefix $(DIR_BIN_DRIVER_PRINT_FRAMEBUFFER)/, $(SOURCE_FILES:.c=.o))
DEP_FILES := $(addprefix $(DIR_BIN_DRIVER_PRINT_FRAMEBUFFER)/, $(SOURCE_FILES:.c=.d))

$(BIN_DRIVER_PRINT_FRAMEBUFFER): $(OBJ_FILES) $(BIN_IO)
	$(AR) r $@ $^

$(DIR_BIN_DRIVER_PRINT_FRAMEBUFFER)/%.o: %.c $(DIR_BIN_DRIVER_PRINT_FRAMEBUFFER)
	$(CC) $(CC_FLAGS) -c $< -o $@

$(DIR_BIN_DRIVER_PRINT_FRAMEBUFFER):
	mkdir -p $@

-include $(DEP_FILES)
